# Copy this file to .env and fill in your own keys. .env is git-ignored.
#
# Nothing here is required for the default summarisation backend: the local
# Hugging Face model (sshleifer/distilbart-cnn-12-6) downloads once and then runs
# on this machine with no key and no credits.

# Free token from https://huggingface.co/settings/tokens.
# HF_API_KEY is the name config.create_client("hf") looks for, so set that one.
# Summarisation accepts either name (HF_TOKEN is kept as an alias).
# Billed against a monthly free credit allowance, not per token.
HF_API_KEY=hf_your-token-here

# Optional. Which model the Inference API backend calls. Only set this if the
# default (Qwen/Qwen2.5-7B-Instruct) is not served for your account - any
# instruction-tuned chat model on the HF router works.
# HF_API_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional. Only needed for the OpenAI backends (text generation, image
# generation, and the "openai" summarisation backend used for cost comparison).
# OPENAI_API_KEY=sk-your-key-here
